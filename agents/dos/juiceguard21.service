[Unit]
Description=JuiceGuard Host Protection Service
After=network-online.target iptables.service
Wants=network-online.target
 
[Service]
Type=simple
 
ExecStart=/usr/bin/python3 -u /opt/juiceguard/juiceguard.py
 
WorkingDirectory=/opt/juiceguard
 
User=root
Group=root
 
Restart=always
RestartSec=5
 
NoNewPrivileges=true
PrivateTmp=true
 
StandardOutput=journal
StandardError=journal
 
[Install]
WantedBy=multi-user.target
