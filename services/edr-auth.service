[Unit]
Description=JuiceGuard EDR auth module
After=network-online.target iptables.service
Wants=network-online.target
 
[Service]
Type=simple
 
ExecStart=/usr/bin/python3 -u /opt/edr/auth/auth_agent.py
 
WorkingDirectory=/opt/edr/auth
 
User=root
Group=root
 
Restart=always
RestartSec=5
 
NoNewPrivileges=true
PrivateTmp=true
 
StandardOutput=journal
StandardError=journal
 
[Install]
WantedBy=multi-user.target
